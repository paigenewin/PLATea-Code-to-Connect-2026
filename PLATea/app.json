{
  "expo": {
    "name": "PeTAL",
    "slug": "PeTAL",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/cherryblossom.png",
    "scheme": "plum",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.allyjt.PLUM",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#fff0f6",
          "image": "./assets/images/cherryblossom.png",
          "imageWidth": 300
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "PLATea uses your camera to identify flowers and trees from a photo.",
          "photosPermission": "PLATea uses your photos to identify flowers and trees from an image."
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "92050424-66ae-4066-b802-dec422573b4c"
      }
    }
  }
}
